# Copy this file to .env and fill in only the line for your source.
# .env is gitignored: never commit it, and never paste a token into a chat.

# Todoist → Settings → Integrations → Developer → API token
TODOIST_API_TOKEN=

# app.raindrop.io/settings/integrations → Create new app → Create test token
RAINDROP_TOKEN=

# notion.so/profile/integrations → New integration → Internal Integration Secret
NOTION_TOKEN=
